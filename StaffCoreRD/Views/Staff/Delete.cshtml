@model StaffCoreRD.Models.Staff
@{
    ViewData["Title"] = "Eliminar Empleado";
}

<h2>Eliminar Empleado</h2>

<div class="alert alert-warning">
    ¿Está seguro que desea eliminar este empleado? Esta acción no se puede deshacer.
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Nombre</h5>
        <p class="card-text">
            <strong>Cédula:</strong> @Model.Cedula <br />
            <strong>Cargo:</strong> @Model.Cargo <br />
            <strong>Departamento:</strong> @Model.Departamento <br />
            <strong>Salario:</strong> @Model.Salario.ToString("C") <br />
            <strong>Fecha de ingreso:</strong> @Model.FechaIngreso.ToShortDateString()
        </p>

        <form asp-controller="Staff" asp-action="Delete" method="post">
            <input asp-for="Id" type="hidden" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-controller="Staff" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>