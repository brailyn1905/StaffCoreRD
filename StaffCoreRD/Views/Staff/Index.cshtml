@model List<StaffCoreRD.Models.Staff>
@{
    ViewData["Title"] = "Personal";
}

<h2>Personal Activo</h2>

@if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
{
    <a asp-controller="Staff" asp-action="Create" class="btn btn-primary mb-3">+ Nuevo</a>
}

@if (!Model.Any())
{
    <p>No hay personal registrado actualmente.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cargo</th>
                <th>Departamento</th>
                <th>Salario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Nombre</td>
                    <td>@s.Cargo</td>
                    <td>@s.Departamento</td>
                    <td>@s.Salario.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total de nómina</th>
                <th>@Model.Sum(s => s.Salario).ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}