@model List<StaffCoreRD.Models.Staff>
@{
    ViewData["Title"] = "Personal";
}

<h2>Personal Activo</h2>

<form asp-controller="Staff" asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="buscar" id="buscarInput"
               value="@ViewData["Buscar"]"
               class="form-control"
               placeholder="Buscar por nombre..." />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>

@if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
{
    <a asp-controller="Staff" asp-action="Create" class="btn btn-primary mb-3">+ Nuevo</a>
}

@if (!Model.Any())
{
    <p>No hay personal registrado actualmente.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Cargo</th>
                <th>Departamento</th>
                <th>Salario</th>
                <th>Fecha de Ingreso</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Nombre</td>
                    <td>@s.Cedula</td>
                    <td>@s.Cargo</td>
                    <td>@s.Departamento</td>
                    <td>@s.Salario.ToString("C")</td>
                    <td>@s.FechaIngreso.ToShortDateString()</td>
                    <td>
                        @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                        {
                            <a asp-controller="Staff" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning">Editar</a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-controller="Staff" asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4">Total de nómina</th>
                <th colspan="3">@Model.Sum(s => s.Salario).ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}

<script>
    let temporizador;
    document.getElementById("buscarInput").addEventListener("input", function () {
        clearTimeout(temporizador);
        const form = this.closest("form");
        temporizador = setTimeout(() => form.submit(), 400);
    });
</script>